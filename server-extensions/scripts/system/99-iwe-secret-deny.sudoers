# iwe-secret-deny — P0 barrier against bulk reads of /etc/iwe/env (WP-544 D27/Vg2, 2026-09-01)
#
# STAGED, NOT INSTALLED. Do not copy into /etc/sudoers.d/ without running
# the checks in scripts/system/README-secret-deny.md first — this changes
# root-command policy on a live host (tsekh-1) and needs an explicit
# go-ahead before it takes effect.
#
# Known residual (not closed by this file, tracked as a follow-up):
# sudo -n awk '1' /etc/iwe/env, sudo -n python3 -c '...', reading through a
# symlink, and any other interpreter/binary not listed here still bypass
# this specific deny. This is a raised bar, not a complete fix — the P1
# capability broker (WP-544 D27) is the actual fix for that residual.
#
# allow + deny live in ONE User_Spec line so the effective policy does not
# depend on file load order across /etc/sudoers.d/.

Cmnd_Alias IWE_SECRET_DENY = \
    /bin/cat /etc/iwe/env, /usr/bin/cat /etc/iwe/env, \
    /bin/less /etc/iwe/env, /usr/bin/less /etc/iwe/env, \
    /bin/more /etc/iwe/env, /usr/bin/more /etc/iwe/env, \
    /bin/head /etc/iwe/env, /usr/bin/head /etc/iwe/env, \
    /bin/tail /etc/iwe/env, /usr/bin/tail /etc/iwe/env, \
    /bin/cp /etc/iwe/env *, /usr/bin/cp /etc/iwe/env *, \
    /usr/bin/scp /etc/iwe/env *

tseren ALL=(ALL:ALL) NOPASSWD: ALL, !IWE_SECRET_DENY
